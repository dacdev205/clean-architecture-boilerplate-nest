<html lang='vi'>
  <head>
    <meta charset='UTF-8' />
    <meta http-equiv='X-UA-Compatible' content='IE=edge' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Email Notification</title>
    <style>
      body { font-family: Arial, sans-serif; background-color: #f4f4f4; padding:
      20px; } .email-container { background-color: #ffffff; padding: 20px;
      border-radius: 8px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); } .footer {
      margin-top: 20px; font-size: 12px; color: #666; }
    </style>
  </head>
  <body>
    <div class='email-container'>
      {{{body}}}
    </div>
    <div class='footer'>
      Do not reply this email.
    </div>
  </body>
</html>
